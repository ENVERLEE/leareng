# Oracle Cloud Database Configuration
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=your-host.oraclecloud.com))(connect_data=(service_name=your-service-name.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Email Configuration (Gmail 사용 시)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# JWT Configuration
JWT_SECRET_KEY=your-very-secret-key-minimum-32-characters-long-change-this-in-production

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Frontend URL (배포 후 실제 도메인으로 변경)
FRONTEND_URL=http://localhost:80

